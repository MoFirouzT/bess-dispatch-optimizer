# Copy to `.env` (gitignored) and fill in. Only needed for the live ENTSO-E
# loader (R1.4b) and its token-gated integration test — CI never reads this.

# ENTSO-E Transparency Platform security token.
# Register at https://transparency.entsoe.eu/ → "My Account Settings" → request
# API access; the token is emailed. Host: https://web-api.tp.entsoe.eu/api
ENTSOE_API_TOKEN=

# --- On-disk price cache (optional) ------------------------------------------
# Where the loaders cache fetched history as parquet. Unset (the default) means
# nothing is cached and every fetch hits the API — which is what CI wants, since
# it has no token and commits no real data. Set it locally to stop re-pulling the
# same frozen windows: day-ahead prices are settled auction results, final once
# published, and each file is keyed on (kind, zone, start, end), so a cached
# window is never stale and a moving window re-fetches on its own.
# `data/cache/` is gitignored; the directory is pure derived data, safe to delete.
# The live integration tests default to it already, with or without this set.
#
# BESS_CACHE_DIR=data/cache

# --- TLS / corporate proxy (this machine only) -------------------------------
# If a TLS-intercepting proxy with a private CA is on the network, uv's bundled
# Python won't trust it and live fetches fail CERTIFICATE_VERIFY_FAILED. Export
# the macOS Keychain roots and point Python at them (operator setup, not code):
#
#   security find-certificate -a -p /Library/Keychains/System.keychain > ca.pem
#   security find-certificate -a -p \
#       /System/Library/Keychains/SystemRootCertificates.keychain >> ca.pem
#
# REQUESTS_CA_BUNDLE=/absolute/path/to/ca.pem   # entsoe-py uses requests
# SSL_CERT_FILE=/absolute/path/to/ca.pem        # stdlib urllib

# --- forecaster group (this machine only) ------------------------------------
# The optional `forecast` group (R2.1: LightGBM/MAPIE) needs the OpenMP runtime.
# On macOS: `brew install libomp`. Linux CI links `libgomp`, so this is a local
# operator step only, not a code dependency.

# --- Narration (R2.4b) -------------------------------------------------------
# Anthropic API key. Only the opt-in live tier reads it
# (tests/integration/test_narration_live.py); every other test runs with it unset
# and exercises the deterministic fallback, which is what CI does. With no key,
# `bess.narrate` returns the fallback without constructing a client, so the
# optional `narrate` extra need not be installed either.
#
#   uv sync --extra narrate
#   set -a; . ./.env; set +a
#   uv run pytest tests/integration/test_narration_live.py -q -s
#
# The live tier makes 50 model calls and costs real money. It exists to measure one
# number, the rejection rate, against the 5% adoption bar in
# docs/specs/dual-narration.md.
ANTHROPIC_API_KEY=
